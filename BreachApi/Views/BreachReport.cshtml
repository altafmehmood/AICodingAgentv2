@model BreachApi.ViewModels.BreachReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Breach Report</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            color: #333;
            line-height: 1.6;
        }
        
        .header {
            text-align: center;
            border-bottom: 3px solid #2c3e50;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        
        .header h1 {
            color: #2c3e50;
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }
        
        .header .subtitle {
            color: #7f8c8d;
            font-size: 14px;
            margin-top: 5px;
        }
        
        .summary {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .summary h2 {
            color: #2c3e50;
            margin-top: 0;
            font-size: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }
        
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }
        
        .summary-item {
            text-align: center;
        }
        
        .summary-item .value {
            font-size: 24px;
            font-weight: bold;
            color: #3498db;
        }
        
        .summary-item .label {
            font-size: 12px;
            color: #7f8c8d;
            text-transform: uppercase;
            margin-top: 5px;
        }
        
        .breach-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        
        .breach-table th {
            background-color: #2c3e50;
            color: white;
            padding: 12px 8px;
            text-align: left;
            font-weight: bold;
            font-size: 12px;
        }
        
        .breach-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #dee2e6;
            font-size: 11px;
        }
        
        .breach-table tr:nth-child(even) {
            background-color: #f8f9fa;
        }
        
        .breach-table tr:hover {
            background-color: #e9ecef;
        }
        
        .domain {
            color: #3498db;
            font-weight: bold;
        }
        
        .pwn-count {
            text-align: right;
            font-weight: bold;
            color: #e74c3c;
        }
        
        .date {
            color: #7f8c8d;
        }
        
        .footer {
            margin-top: 30px;
            text-align: center;
            color: #7f8c8d;
            font-size: 10px;
            border-top: 1px solid #dee2e6;
            padding-top: 15px;
        }
        
        .no-data {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Breach Report</h1>
        <div class="subtitle">
            Date Range: @Model.DateRangeDisplay<br>
            Generated: @Model.GeneratedDate.ToString("yyyy-MM-dd HH:mm UTC")
        </div>
    </div>
    
    <div class="summary">
        <h2>Summary</h2>
        <div class="summary-grid">
            <div class="summary-item">
                <div class="value">@Model.TotalBreaches.ToString("N0")</div>
                <div class="label">Total Breaches</div>
            </div>
            <div class="summary-item">
                <div class="value">@Model.TotalAffectedUsers.ToString("N0")</div>
                <div class="label">Affected Users</div>
            </div>
            <div class="summary-item">
                <div class="value">@(Model.TotalBreaches > 0 ? (Model.TotalAffectedUsers / Model.TotalBreaches).ToString("N0") : "0")</div>
                <div class="label">Avg Users per Breach</div>
            </div>
        </div>
    </div>
    
    @if (Model.Breaches.Any())
    {
        <table class="breach-table">
            <thead>
                <tr>
                    <th>Breach Name</th>
                    <th>Domain</th>
                    <th>Added Date</th>
                    <th>Affected Users</th>
                    <th>Data Classes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var breach in Model.Breaches)
                {
                    <tr>
                        <td><strong>@breach.Name</strong></td>
                        <td class="domain">@breach.Domain</td>
                        <td class="date">@breach.AddedDate.ToString("yyyy-MM-dd")</td>
                        <td class="pwn-count">@breach.PwnCount.ToString("N0")</td>
                        <td>@string.Join(", ", breach.DataClasses.Take(3))@(breach.DataClasses.Count > 3 ? "..." : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="no-data">
            <h3>No breaches found for the specified date range.</h3>
            <p>Try adjusting your date filters or check back later for new data.</p>
        </div>
    }
    
    <div class="footer">
        <p>Breach Report generated by Breach API | @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm UTC")</p>
    </div>
</body>
</html> 