{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ExternalApi": {
    "HaveIBeenPwned": {
      "BaseUrl": "https://haveibeenpwned.com/api/v3/breaches",
      "TimeoutSeconds": 30,
      "UserAgent": "BreachApi-1.0"
    }
  },
  "Caching": {
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 10
  },
  "Resilience": {
    "CircuitBreaker": {
      "HandledEventsAllowedBeforeBreaking": 3,
      "BreakDurationSeconds": 30
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "DelaySeconds": 1
    }
  },
  "Validation": {
    "MinAllowedYear": 2007,
    "MaxDateRangeDays": 3650
  }
}
